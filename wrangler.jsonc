{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-07-20",
	"compatibility_flags": [
		"nodejs_compat_v2"
	],
	"placement": {
		"mode": "smart"
	},
	"cache": {
		"enabled": true
	},
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{
			"pattern": "giuliotognetto.dev",
			"custom_domain": true,
			"enabled": true
		}
	],
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		],
		"binding": "ASSETS",
		"directory": "./.output/public/"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "CURSOR_TRACKER",
				"class_name": "CursorTracker"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"CursorTracker"
			]
		}
	],
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}